{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentwallet.ir/schemas/v1/payment-intent.schema.json",
  "title": "Agent-Pay V1 Payment Intent",
  "type": "object",
  "required": ["agent_id", "account_id", "merchant", "amount", "purpose"],
  "properties": {
    "agent_id": {"type": "string", "minLength": 1},
    "account_id": {"type": "string", "minLength": 1},
    "merchant": {"$ref": "#/$defs/merchant"},
    "amount": {"$ref": "#/$defs/money"},
    "purpose": {"type": "string", "minLength": 1},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "commerce_context": {"type": "object", "additionalProperties": true},
    "authorization_evidence": {"$ref": "#/$defs/authorizationEvidence"},
    "preferred_instrument_id": {"type": "string"}
  },
  "$defs": {
    "money": {
      "type": "object",
      "required": ["value", "currency"],
      "properties": {
        "value": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,4})?$"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      },
      "additionalProperties": false
    },
    "merchant": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "domain": {"type": "string"},
        "category": {"type": "string"},
        "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "merchant_reference": {"type": "string"}
      }
    },
    "item": {
      "type": "object",
      "required": ["name", "quantity", "unit_price"],
      "properties": {
        "name": {"type": "string"},
        "quantity": {"type": "integer", "minimum": 1},
        "unit_price": {"$ref": "#/$defs/money"}
      }
    },
    "authorizationEvidence": {
      "type": "object",
      "properties": {
        "evidence_id": {"type": "string"},
        "issuer": {"type": "string"},
        "evidence_type": {"type": "string"},
        "digest": {"type": "string"},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "source_reference": {"type": "string"}
      }
    }
  }
}
